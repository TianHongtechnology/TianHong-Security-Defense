;
; TianHongDefenseKernelProtection.Network.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = TianHongDefenseKernelProtection.Network.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TianHongDefenseKernelProtection.Network.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%TianHongDefenseKernelProtection.Network.DeviceDesc% = TianHongDefenseKernelProtection.Network_Device, Root\TianHongDefenseKernelProtection.Network ; TODO: edit hw-id

[TianHongDefenseKernelProtection.Network_Device.NT]
CopyFiles = File_Copy

[File_Copy]
TianHongDefenseKernelProtection.Network.sys

;-------------- Service installation
[TianHongDefenseKernelProtection.Network_Device.NT.Services]
AddService = TianHongDefenseKernelProtection.Network,%SPSVCINST_ASSOCSERVICE%, TianHongDefenseKernelProtection.Network_Service_Inst

; -------------- TianHongDefenseKernelProtection.Network driver install sections
[TianHongDefenseKernelProtection.Network_Service_Inst]
DisplayName    = %TianHongDefenseKernelProtection.Network.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\TianHongDefenseKernelProtection.Network.sys

[TianHongDefenseKernelProtection.Network_Device.NT.Wdf]
KmdfService = TianHongDefenseKernelProtection.Network, TianHongDefenseKernelProtection.Network_wdfsect

[TianHongDefenseKernelProtection.Network_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "TianHongDefenseKernelProtection.Network Installation Disk"
TianHongDefenseKernelProtection.Network.DeviceDesc = "TianHongDefenseKernelProtection.Network Device"
TianHongDefenseKernelProtection.Network.SVCDESC = "TianHongDefenseKernelProtection.Network Service"
